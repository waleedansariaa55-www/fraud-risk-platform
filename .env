# Copy this file to .env and fill in real values before deploying.

# Postgres in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/fraud_platform
# Defaults to local SQLite if unset (fine for local dev/demo).
DATABASE_URL=sqlite:///./fraud_platform.db

# Generate a real secret, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_string

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_CSV_ROWS_PER_IMPORT=50000
